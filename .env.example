VITE_API_BASE_URL=http://127.0.0.1:3000/api/v1
VITE_GOOGLE_CLIENT_ID=
# Credential exchange uses Google Identity Services; no redirect URI is used.
# VITE_* values are PUBLIC browser build configuration. Never put secrets,
# administrator email lists or private contact details in them.
VITE_DEVELOPMENT_SIGN_IN=false
# Comma-separated local test identities; keep values private and aligned with
# TRISE_DEVELOPMENT_SIGN_IN_EMAILS in the API environment.
VITE_DEVELOPMENT_SIGN_IN_EMAILS=
# Playwright only (export privately in the test process; never VITE_):
# TRISE_E2E_GLOBAL_ADMIN_EMAIL=
# TRISE_E2E_PROVIDER_ADMIN_EMAIL=
# TRISE_E2E_OPERATOR_EMAIL=
