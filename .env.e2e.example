# Copy this file to .env.e2e.local and replace every placeholder privately.
# .env.e2e.local is ignored and must never be committed.

TRISE_E2E_DEVELOPMENT_SIGN_IN=<true-to-enable-authenticated-e2e>
TRISE_E2E_API_URL=<local-api-url>
TRISE_E2E_CUSTOMER_URL=<local-customer-url>
TRISE_E2E_OPERATIONS_URL=<local-operations-url>
# Optional public S3/CloudFront URL for the maintenance fallback manifest.
# The UI uses the API first and reads this URL when the API is unavailable.
VITE_PLATFORM_AVAILABILITY_S3_URL=<public-availability-manifest-url>

# Optional browser/runtime controls.
TRISE_E2E_CHANNEL=<playwright-or-chrome>
TRISE_E2E_STORAGE=<true-or-false>

# Required when authenticated development-sign-in projects are selected.
# These are role fixtures, not credentials. Keep the matching local secrets in
# the approved private API development-sign-in secrets file.
TRISE_E2E_LOCAL_SECRETS_FILE=<absolute-path-to-private-api-development-sign-in-secrets>
TRISE_E2E_GLOBAL_ADMIN_EMAIL=<global-admin-email>
TRISE_E2E_PLATFORM_REVIEWER_EMAIL=<platform-reviewer-email>
TRISE_E2E_PROVIDER_ADMIN_EMAIL=<provider-admin-email>
TRISE_E2E_PROVIDER_REVIEWER_EMAIL=<provider-reviewer-email>
TRISE_E2E_OPERATOR_EMAIL=<operator-email>
TRISE_E2E_CUSTOMER_EMAIL=<customer-email>
TRISE_E2E_AGENT_EMAIL=<agent-email>
TRISE_E2E_MARKETING_EXECUTIVE_EMAIL=<marketing-executive-email>
TRISE_E2E_MARKETING_MANAGER_EMAIL=<marketing-manager-email>
TRISE_E2E_ASSET_ADMINISTRATOR_EMAIL=<asset-administrator-email>

# Optional synthetic fixture IDs for tests that exercise those workflows.
TRISE_E2E_CHANGE_REQUEST_BUSINESS_ID=<synthetic-business-id>
TRISE_E2E_ACTIVATION_PROVIDER_ID=<synthetic-provider-id>
TRISE_E2E_ACCESS_WORKFLOWS=<true-or-false>
TRISE_E2E_RESTORE_ACCESS_BASELINE=<true-or-false>
